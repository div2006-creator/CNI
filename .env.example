# Application Config
APP_NAME="AI Criminal Network Intelligence System"
APP_ENV=development
DEBUG=True
API_PREFIX=/api
PORT=8000
HOST=0.0.0.0

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Security Secrets (Generate a strong key in production)
SECRET_KEY=change-this-super-secret-key-in-production-32bytes-min
ALGORITHM=HS256

# Database Settings (PostgreSQL - Future / Optional)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=intel_network_db

# Graph Database Settings (Neo4j - Future / Optional)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
USE_MOCK_GRAPH=True

# AI / NLP Settings
NLP_MODEL_NAME=en_core_web_sm
ENTITY_CONFIDENCE_THRESHOLD=0.75
PATTERN_RISK_THRESHOLD=0.60
