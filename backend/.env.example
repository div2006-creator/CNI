# CNI Environment Configuration Template

APP_NAME="CNI Intelligence Platform"
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=intel_network_db

# Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
USE_MOCK_GRAPH=True

# External API Integrations (Phase 4)
GEOCODING_ENABLED=True
NOMINATIM_USER_AGENT=CNI-Intelligence-Platform/2.0
NEWS_API_ENABLED=True
NEWS_API_KEY=
AI_EXTRACTION_ENABLED=True
AI_PROVIDER=mock
AI_API_KEY=
